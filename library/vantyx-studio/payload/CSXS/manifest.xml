<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="8.0" ExtensionBundleId="com.vantyx.studio"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="Vantyx Studio">
    <ExtensionList>
        <Extension Id="com.vantyx.studio.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[13.0,99.0]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="8.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.vantyx.studio.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/vtx-index.html</MainPath>
                    <ScriptPath>./host/vtx-main.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Vantyx Studio</Menu>
                    <Geometry>
                        <Size>
                            <Height>560</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2000</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons></Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
