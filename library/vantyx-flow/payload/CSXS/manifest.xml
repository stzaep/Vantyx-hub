<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="8.0" ExtensionBundleId="com.vantyx.flow" ExtensionBundleVersion="1.1.0" xmlns:ExtensionBundleId="http://ns.adobe.com/ExtensionManifest/8.0">
    <ExtensionList>
        <Extension Id="com.vantyx.flow.panel" Version="1.1.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[15.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="8.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.vantyx.flow.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/main.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Vantyx Flow</Menu>
                    <Geometry>
                        <Size>
                            <Height>650</Height>
                            <Width>280</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2000</Height>
                            <Width>500</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/assets/icon.png</Icon>
                        <Icon Type="RollOver">./client/assets/icon.png</Icon>
                        <Icon Type="Disabled">./client/assets/icon.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
